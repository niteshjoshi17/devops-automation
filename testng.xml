<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AutomationSuite" verbose="1" parallel="false">

    <!-- ✅ 1st: Run setup to launch browser + login -->
    <test name="Global Setup">
        <classes>
            <class name="com.forus.qa.setup.TestSetup"/>
        </classes>
    </test>

    <!-- ✅ 2nd: Run all actual test classes -->
    <test name="Dashboard Page Tests">
        <classes>
            <class name="com.forus.qa.testcases.DashboardPageTest"/>
        </classes>
    </test>

    <test name="Portfolio Page Tests">
        <classes>
            <class name="com.forus.qa.testcases.PortfolioPageTest"/>
        </classes>
    </test>

    <test name="Wallet Page Tests">
        <classes>
            <class name="com.forus.qa.testcases.WalletPageTest"/>
        </classes>
    </test>

</suite>
